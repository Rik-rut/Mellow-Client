{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mellow",
  "version": "0.1.0",
  "identifier": "dev.mellow.client",
  "build": {
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mellow",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "additionalBrowserArgs": "--ignore-certificate-errors --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Mellow",
    "shortDescription": "Mellow LAN chat",
    "longDescription": "Desktop client for self-hosted Mellow LAN chat servers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Mellow"
      }
    }
  }
}
